# Copy to backend/.env (or .env at the repo root) and fill in what you have.
# Never commit the real file. Relative paths resolve against the repo root.

MODE=replay                     # replay | live
DB_PATH=data/satya.db
HMAC_SECRET=change-me-32-chars-minimum-secret
JWT_SECRET=change-me-jwt-secret
K_ANON=10
DP_EPSILON=1.0                  # Laplace noise budget for released demographic counts
PROXY_URL=

# --- Live collectors (PS 26152 A). Leave blank to skip a platform. ---
# X / Twitter (essential): cookies from a logged-in burner account on x.com
X_ACCOUNT_USER=
X_AUTH_TOKEN=
X_CT0=
# Telegram (essential): https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=tg.session
# Reddit (appreciable): https://www.reddit.com/prefs/apps -> "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=satyanet/0.1
# YouTube (appreciable): Google Cloud Console -> YouTube Data API v3 key
YT_API_KEY=

# --- Models ---
HF_TOKEN=                       # optional; raises Hugging Face rate limits
EMOTION_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MODELS_DIR=models

# --- LLM narrative summaries (Backlog B4) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Evidence ledger ---
ENABLE_OTS=false                # true = anchor checkpoint roots via public OpenTimestamps calendars

# --- Graph store (NetworkX default; Neo4j optional) ---
GRAPH_STORE=networkx
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

REPLAY_SPEED=60
SCENARIO_PATH=replay/scenario_v1.jsonl
